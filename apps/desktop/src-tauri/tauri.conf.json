{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeetingRelay",
  "version": "0.1.1",
  "identifier": "com.meetingrelay.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MeetingRelay · 本地实时转写",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true
      },
      {
        "label": "caption-overlay",
        "url": "index.html?view=overlay",
        "title": "MeetingRelay Caption Overlay",
        "width": 760,
        "height": 180,
        "minWidth": 480,
        "minHeight": 120,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "style-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MeetingRelay",
    "copyright": "Copyright (c) MeetingRelay contributors",
    "licenseFile": "../../../NOTICE.md",
    "resources": {
      "resources/": ""
    },
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../../tools/distribution/Sign-ReleaseArtifact.ps1",
          "-FilePath",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../../tools/distribution/nsis-hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
