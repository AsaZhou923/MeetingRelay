{
  "name": "meetingrelay-workspace",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "desktop:dev": "pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm --dir apps/desktop build",
    "desktop:typecheck": "pnpm --dir apps/desktop typecheck",
    "desktop:test": "pnpm --dir apps/desktop test",
    "mvp:release:personal": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/mvp/release.ps1",
    "mvp:release:personal:test": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/mvp/release.test.ps1",
    "mvp:acceptance:test": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \"& { & 'tools/mvp/acceptance/Measure-WindowsAcceptance.test.ps1'; & 'tools/mvp/acceptance/Run-LiveProviderMatrix.test.ps1' }\"",
    "distribution:release": "node tools/powershell/Run-WindowsPowerShell.mjs tools/distribution/release.ps1",
    "distribution:release:dry-run": "node tools/powershell/Run-WindowsPowerShell.mjs tools/distribution/release.ps1 -DryRun",
    "distribution:release:unsigned-test": "node tools/powershell/Run-WindowsPowerShell.mjs tools/distribution/release.ps1 -UnsignedTestBuild",
    "distribution:test": "node tools/powershell/Run-WindowsPowerShell.mjs tools/distribution/Assert-DistributionContract.test.ps1",
    "tauri": "pnpm --dir apps/desktop tauri"
  }
}
